# Copy to .env and adjust. Never commit .env.
# More variables (Trello, n8n, Telegram) are added as each integration lands.

# --- PostgreSQL ---
POSTGRES_DB=agent_office
POSTGRES_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/agent_office
DB_USERNAME=agent_office
DB_PASSWORD=agent_office

# --- Application ---
SERVER_PORT=8080

# --- Ollama ---
# Ollama running natively on the host (recommended on macOS for GPU acceleration).
# From inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Default model for every agent; override per agent if needed.
OLLAMA_MODEL=qwen3:8b
# OLLAMA_MODEL_MANAGER=
# OLLAMA_MODEL_RESEARCH=
# OLLAMA_MODEL_DEVELOPER=
# OLLAMA_MODEL_REVIEWER=
OLLAMA_READ_TIMEOUT=180s

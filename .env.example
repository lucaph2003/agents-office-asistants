# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=agent_office
POSTGRES_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/agent_office
DB_USERNAME=agent_office
DB_PASSWORD=agent_office

# --- Application ---
# Port when running with ./mvnw spring-boot:run on the host.
SERVER_PORT=8080
# Host port of the agent-office-core container (docker compose).
AGENT_OFFICE_PORT=8080
# Shared secret for the REST API (X-Api-Key header). n8n uses it to call Agent Office.
# Generate one with: openssl rand -hex 24
AGENT_OFFICE_API_KEY=change-me-to-a-long-random-string

# --- Ollama ---
# Ollama running natively on the host (recommended on macOS for GPU acceleration).
# From inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Same Ollama, as seen from the agent-office-core container. Use http://ollama:11434 with --profile ollama.
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# Default model for every agent; override per agent if needed.
OLLAMA_MODEL=qwen3:8b
# OLLAMA_MODEL_MANAGER=
# OLLAMA_MODEL_RESEARCH=
# OLLAMA_MODEL_DEVELOPER=
# OLLAMA_MODEL_REVIEWER=
OLLAMA_READ_TIMEOUT=180s

# --- Trello ---
# Off by default; the app works without a board. See scripts/trello-setup.sh to create the
# board and lists and print the ids below.
TRELLO_ENABLED=false
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token
TRELLO_BOARD_ID=
TRELLO_LIST_INBOX=
TRELLO_LIST_PLANNED=
TRELLO_LIST_IN_PROGRESS=
TRELLO_LIST_REVIEW=
TRELLO_LIST_BLOCKED=
TRELLO_LIST_DONE=

# --- n8n / Telegram ---
# Base URL n8n uses to call Agent Office (inside Docker Compose: the service name).
AGENT_OFFICE_API_URL=http://agent-office-core:8080
# Comma-separated Telegram chat ids allowed to use the bot. Empty means nobody.
TELEGRAM_ALLOWED_CHAT_IDS=
# Your own chat id: receives results of tasks created from the Trello inbox, and /tasks there lists all tasks.
TELEGRAM_DEFAULT_CHAT_ID=
# Public HTTPS URL of n8n, e.g. a tunnel; Telegram delivers updates there (see docs/n8n.md).
N8N_WEBHOOK_URL=
# Agent Office -> n8n notifications (task completed / failed / blocked).
N8N_NOTIFICATIONS_ENABLED=false
N8N_TASK_COMPLETED_WEBHOOK_URL=http://n8n:5678/webhook/agent-office/task-completed
# Shared secret checked by the notification webhook. Generate with: openssl rand -hex 24
N8N_WEBHOOK_TOKEN=change-me-to-a-long-random-string

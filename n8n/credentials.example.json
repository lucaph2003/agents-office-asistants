  },
  {
    "id": "agent-office-api-key",
    "name": "Agent Office API key",
    "type": "httpHeaderAuth",
    "data": { "name": "X-Api-Key", "value": "same-value-as-AGENT_OFFICE_API_KEY" }
  },
  {
    "id": "agent-office-webhook-token",
    "name": "Agent Office webhook token",
    "type": "httpHeaderAuth",
    "data": { "name": "X-Agent-Office-Token", "value": "same-value-as-N8N_WEBHOOK_TOKEN" }
  }
]
